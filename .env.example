# Copy to .env and fill in. Do NOT commit the real .env.

# =====================================================================
# PRODUCTION (docker-compose.yml) — only the MCP container.
# Keycloak and TLS termination are provided by your own infrastructure.
# =====================================================================

# Issuer of your existing Keycloak realm.
OIDC_ISSUER=https://auth.example.com/realms/intervals

# Public URL this MCP server is reachable at (behind your reverse proxy/TLS).
MCP_RESOURCE_URL=https://mcp.example.com

# Host port to publish the container on (fronted by your proxy).
MCP_PORT=8000

# Optional overrides (defaults shown):
# MCP_AUDIENCE=intervals-mcp-server
# ATHLETE_CLAIM=intervals_athlete_id
# APIKEY_CLAIM=intervals_api_key
# INTERVALS_BASE_URL=https://intervals.icu/api/v1
# MCP_PATH=/mcp

# =====================================================================
# LOCAL / ALL-IN-ONE STACK (docker-compose.dev.yml) — adds Keycloak,
# Postgres and a Caddy reverse proxy. Not needed in production.
# =====================================================================

# Public hostnames (must resolve to this host for automatic TLS)
AUTH_DOMAIN=auth.example.com
MCP_DOMAIN=mcp.example.com

# Keycloak database
KC_DB_PASSWORD=change-me-strong-db-password

# Keycloak bootstrap admin (first start only)
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me-strong-admin-password
